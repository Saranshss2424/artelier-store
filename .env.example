# Google Identity Services (OAuth Web Client)
# Create an OAuth 2.0 Web Client and authorize your actual production origin.
GOOGLE_CLIENT_ID=
# Generate a random 32+ character secret; never commit the real value.
GOOGLE_SESSION_SECRET=
# Optional comma-separated origins used only if auth requests come from alternate trusted domains.
GOOGLE_ALLOWED_ORIGINS=

ADMIN_EMAIL=
ENABLE_COD=false
ENABLE_ONLINE_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Existing alternative gateway. Configure one provider only.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Optional external scheduler: POST /api/jobs with Authorization: Bearer <secret>
# Generate a random value of at least 32 bytes. Never commit a real value.
JOB_RUNNER_SECRET=

# Resend transactional order emails; use a verified sender domain
ENABLE_EMAIL=false
RESEND_API_KEY=
EMAIL_FROM=
# Shiprocket bearer token; rotate before its expiry
SHIPROCKET_TOKEN=
# Route must be approved; enable only after test-mode acceptance
ENABLE_ARTIST_TRANSFERS=false
ARTIST_HOLD_DAYS=
# Set to the verified custom domain origin after DNS activation
PUBLIC_SITE_URL=https://artelier-saransh.ethanhuntss.chatgpt.site
